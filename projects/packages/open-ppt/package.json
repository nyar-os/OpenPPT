{
    "name": "@wae/open-ppt",
    "version": "0.0.2",
    "description": "Editable presentation decks: playback, visual editing and agent authoring on one deck model",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-ppt": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:test": "tsc -p tsconfig.test.json",
        "example": "node dist-test/examples/review-workflow.js",
        "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js dist-test/tests/native.test.js dist-test/tests/error-contract.test.js"
    },
    "keywords": [
        "pptx",
        "powerpoint",
        "presentation",
        "slides",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenPPT.git",
        "directory": "projects/packages/open-ppt"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-ppt-darwin-arm64": "workspace:*",
        "@wae/open-ppt-darwin-x64": "workspace:*",
        "@wae/open-ppt-linux-arm64": "workspace:*",
        "@wae/open-ppt-linux-x64": "workspace:*",
        "@wae/open-ppt-win32-x64": "workspace:*"
    }
}

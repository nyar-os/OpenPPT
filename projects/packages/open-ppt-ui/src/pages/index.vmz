}
</style>

<script client>
const FALLBACK_DECK = {
    id: "preview",
    revision: 0,
    title: "Preview deck",
    size: { widthPt: 960, heightPt: 540 },
    layouts: [],
    slides: [{ id: "preview-1", index: 0, title: "Preview slide", hidden: false, elements: 3, notes: null }],
};

const PRESENTATION_EXTENSIONS = ["pptx", "pptm", "ppsx", "ppsm", "potx", "potm"];

function svgUrl(svg) {
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
}

export default class StudioPage {
    hostReady = false;
    status = "Starting";
    errorText = "";
    projectPath = "";
    savePath = "";
    currentSlideId = "";
    selectedId = "";
    scale = 0.8;
    presentScale = 0.8;
    presenting = false;
    deck = FALLBACK_DECK;
    slide = null;
    imageCache = {};
    handle = 0;
    player = null;
    playerHandle = 0;
    playerIndex = 1;
    playerCache = {};
    seq = 0;
    pending = {};
    drag = null;
    dragRect = null;
    dragTargetId = "";

    onMount() {
        // Static render (build-time SSR) has no window; the client mount below
        // takes over in the WebView or a regular browser tab.
        if (typeof window === "undefined") {
            return;
        }
        const view = window;
        const webview = view.chrome && view.chrome.webview;
        if (webview) {
            this.hostReady = true;
            webview.addEventListener("message", (event) => this.onHostMessage(event));
            void this.ready();
        } else {
            this.hostReady = false;
            this.status = "Preview mode — native window unavailable";
            this.slide = this.previewSlide();
        }

        document.addEventListener("click", (event) => void this.onClick(event));
        document.addEventListener("change", (event) => void this.onChange(event));
        document.addEventListener("pointerdown", (event) => this.onPointerDown(event));
        window.addEventListener("pointermove", (event) => this.onPointerMove(event));
        window.addEventListener("pointerup", () => void this.onPointerUp());
        window.addEventListener("resize", () => this.measure());
        window.addEventListener("keydown", (event) => this.onKeyDown(event));
        this.measure();
    }

    round(value) {
        return Math.round(value);
    }

    deckWidth() {
        return this.deck.size.widthPt || 960;
    }

    deckHeight() {
        return this.deck.size.heightPt || 540;
    }

    currentSlide() {
        if (!this.deck) {
            return null;
        }
        return this.deck.slides.find((item) => item.id === this.currentSlideId) || null;
    }

    selectedElement() {
        if (!this.slide || !this.selectedId) {
            return null;
        }
        return this.slide.elements.find((item) => item.id === this.selectedId) || null;
    }

    hasSelection() {
        return this.selectedElement() !== null;
    }

    playerMode() {
        return this.player !== null;
    }

    playerTitle() {
        return this.player && this.player.title ? this.player.title : "Presentation";
    }

    playerSlides() {
        return this.player ? this.player.slides : [];
    }

    playerSlideCount() {
        return this.player ? this.player.slides.length : 0;
    }

    playerIssueCount() {
        return this.player ? this.player.issues.length : 0;
    }

    playerCanvas() {
        if (!this.player) {
            return "";
        }
        return `${this.round(this.player.size.widthPx)}×${this.round(this.player.size.heightPx)}px`;
    }

    playerImage() {
        const frame = this.playerCache[this.playerIndex];
        return frame ? svgUrl(frame.svg) : "";
    }

    isPresentationPath(file) {
        const dot = file.lastIndexOf(".");
        const extension = dot < 0 ? "" : file.slice(dot + 1).trim().toLowerCase();
        return PRESENTATION_EXTENSIONS.indexOf(extension) >= 0;
    }

    fieldValue(name) {
        const element = this.selectedElement();
        if (!element) {
            return "";
        }
        const transform = element.transform;
        if (name === "x") {
            return Math.round(transform.xPt);
        }
        if (name === "y") {
            return Math.round(transform.yPt);
        }
        if (name === "width") {
            return Math.round(transform.widthPt);
        }
        if (name === "height") {
            return Math.round(transform.heightPt);
        }
        if (name === "rotation") {
            return Math.round(transform.rotationDeg || 0);
        }
        return "";
    }

    frameStyle() {
        return `width:${this.deckWidth() * this.scale}pt;height:${this.deckHeight() * this.scale}pt;`;
    }

    stageStyle() {
        return this.stageCss(this.scale);
    }

    presentFrameStyle() {
        if (this.playerMode()) {
            return "";
        }
        return `width:${this.deckWidth() * this.presentScale}pt;height:${this.deckHeight() * this.presentScale}pt;`;
    }

    presentStageStyle() {
        return this.stageCss(this.presentScale);
    }

    presentLabel() {
        if (this.playerMode()) {
            return `${this.playerIndex} / ${this.player.slides.length}`;
        }
        const slide = this.currentSlide();
        return slide ? `${slide.index + 1} / ${this.deck.slides.length}` : `${this.deck.slides.length} / ${this.deck.slides.length}`;
    }

    elementBoxes() {
        if (!this.slide) {
            return [];
        }
        return this.slide.elements
            .filter((element) => element.kind !== "text")
            .map((element) => ({ id: element.id, style: this.boxStyle(element) }));
    }

    imageBlocks() {
        if (!this.slide) {
            return [];
        }
        const blocks = [];
        for (const element of this.slide.elements) {
            const assetId = element.content && element.content.assetId;
            const src = assetId ? this.imageCache[assetId] : "";
            if (element.kind === "image" && src) {
                blocks.push({ id: element.id, src, style: this.rectCss(this.effectiveTransform(element), true) });
            }
        }
        return blocks;
    }

    textBlocks() {
        if (!this.slide) {
            return [];
        }
        const blocks = [];
        for (const element of this.slide.elements) {
            if (element.kind === "text") {
                blocks.push({
                    key: `${element.id}-text`,
                    elId: element.id,
                    text: element.text || "",
                    style: this.textCss(element, element.transform),
                });
            } else if (element.kind === "formula") {
                blocks.push({
                    key: `${element.id}-formula`,
                    elId: element.id,
                    text: (element.content && element.content.expression) || "",
                    style: this.textCss(element, element.transform, true),
                });
            } else if (element.kind === "table") {
                for (const cell of this.tableCells(element)) {
                    blocks.push(cell);
                }
            } else if (element.kind === "chart") {
                const chartType = (element.content && element.content.chartType) || "chart";
                const data = (element.content && element.content.data) || {};
                const series = data.series || [];
                const categories = data.categories || [];
                blocks.push({
                    key: `${element.id}-label`,
                    elId: element.id,
                    text: `${chartType} · ${series.length} series · ${categories.length} categories`,
                    style: this.captionCss(element),
                });
            } else if (element.kind === "media") {
                blocks.push({
                    key: `${element.id}-media`,
                    elId: element.id,
                    text: (element.content && element.content.mediaType) || "media",
                    style: this.captionCss(element),
                });
            }
        }
        return blocks;
    }

    barBlocks() {
        if (!this.slide) {
            return [];
        }
        const bars = [];
        for (const element of this.slide.elements) {
            if (element.kind !== "chart") {
                continue;
            }
            const type = String((element.content && element.content.chartType) || "").toLowerCase();
            if (type.indexOf("bar") < 0 && type.indexOf("column") < 0) {
                continue;
            }
            const data = element.content && element.content.data;
            const values = data && data.series && data.series[0] ? data.series[0].values || [] : [];
            if (!values.length) {
                continue;
            }
            const rect = this.effectiveTransform(element);
            const max = Math.max.apply(null, values.concat([1]));
            const gap = rect.widthPt * 0.06;
            const slot = (rect.widthPt - gap * 2) / values.length;
            const barWidth = slot * 0.62;
            const base = rect.yPt + rect.heightPt * 0.82;
            const height = rect.heightPt * 0.62;
            values.forEach((value, index) => {
                const barHeight = Math.max((value / max) * height, 1);
                bars.push({
                    key: `${element.id}-bar-${index}`,
                    elId: element.id,
                    style: `left:${rect.xPt + gap + slot * index + (slot - barWidth) / 2}pt;top:${base - barHeight}pt;width:${barWidth}pt;height:${barHeight}pt;`,
                });
            });
        }
        return bars;
    }

    selectionStyle() {
        const element = this.selectedElement();
        if (!element) {
            return "display:none;";
        }
        const rect = element.transform;
        return `left:${rect.xPt}pt;top:${rect.yPt}pt;width:${rect.widthPt}pt;height:${rect.heightPt}pt;transform:rotate(${rect.rotationDeg || 0}deg);`;
    }

    handleStyle() {
        const element = this.selectedElement();
        if (!element) {
            return "display:none;";
        }
        const rect = element.transform;
        return `left:${rect.xPt + rect.widthPt - 5}pt;top:${rect.yPt + rect.heightPt - 5}pt;`;
    }

    stageCss(scale) {
        const background = (this.slide && this.slide.background) || "#fffcf6";
        return `width:${this.deckWidth()}pt;height:${this.deckHeight()}pt;transform:scale(${scale});transform-origin:0 0;background:${background};`;
    }

    effectiveTransform(element) {
        if (this.dragRect && this.dragTargetId === element.id) {
            return this.dragRect;
        }
        return element.transform;
    }

    rectCss(rect, image) {
        const base = `left:${rect.xPt}pt;top:${rect.yPt}pt;width:${rect.widthPt}pt;height:${rect.heightPt}pt;transform:rotate(${rect.rotationDeg || 0}deg);`;
        return image ? base : `${base}background:#efe7d9;`;
    }

    boxStyle(element) {
        const rect = this.effectiveTransform(element);
        const base = this.rectCss(rect, false);
        const content = element.content || {};
        if (element.kind === "shape") {
            const fill = content.fill || "";
            const background = !fill || fill === "none" ? "transparent" : fill;
            const line = content.line && content.line.color ? `border:1px solid ${content.line.color};` : "";
            const radius = content.geometry === "ellipse" ? "border-radius:50%;" : content.geometry === "roundRect" ? "border-radius:8pt;" : "";
            return `${base}background:${background};${line}${radius}`;
        }
        if (element.kind === "image") {
            return `${base}background:#1d1a1622;`;
        }
        if (element.kind === "table") {
            return `${base}background:#fff;border:1px solid #d9cebc;`;
        }
        if (element.kind === "chart") {
            return `${base}background:#fffcf6;border:1px solid #d9cebc;`;
        }
        return base;
    }

    textCss(element, rect, center) {
        const style = element.style || {};
        const size = style.sizePt || 18;
        const weight = style.bold ? 600 : 400;
        const italic = style.italic ? "italic" : "normal";
        const color = style.color || "#1d1a16";
        const family = style.fontFamily || "Segoe UI, system-ui, sans-serif";
        let align = "left";
        if (center || style.align === "center") {
            align = "center";
        } else if (style.align === "right") {
            align = "right";
        }
        const padding = 4;
        const top = center ? rect.yPt + rect.heightPt / 2 - size * 0.7 : rect.yPt + padding;
        return `left:${rect.xPt + padding}pt;top:${top}pt;width:${rect.widthPt - padding * 2}pt;height:${rect.heightPt - padding * 2}pt;font-size:${size}pt;font-weight:${weight};font-style:${italic};color:${color};font-family:${family};text-align:${align};line-height:1.25;`;
    }

    captionCss(element) {
        const rect = element.transform;
        return `left:${rect.xPt + 6}pt;top:${rect.yPt + 5}pt;width:${rect.widthPt - 12}pt;font-size:9pt;color:#6d6458;font-family:Segoe UI, system-ui, sans-serif;`;
    }

    tableCells(element) {
        const rect = this.effectiveTransform(element);
        const content = element.content || {};
        const columns = content.columnWidthsPt || [];
        const rows = content.rows || [];
        const blocks = [];
        let top = rect.yPt;
        rows.forEach((row, rowIndex) => {
            let left = rect.xPt;
            row.cells.forEach((cell, cellIndex) => {
                const width = columns[cellIndex] || rect.widthPt / Math.max(row.cells.length, 1);
                const height = row.heightPt || 24;
                const fill = cell.fill && cell.fill !== "none" ? cell.fill : "#ffffff";
                blocks.push({
                    key: `${element.id}-cell-${rowIndex}-${cellIndex}`,
                    elId: element.id,
                    text: cell.text || "",
                    style: `left:${left + 2}pt;top:${top + 2}pt;width:${width - 4}pt;height:${height - 4}pt;padding:2pt 3pt;background:${fill};border:0.5pt solid #d9cebc;font-size:9pt;color:#1d1a16;font-family:Segoe UI, system-ui, sans-serif;overflow:hidden;`,
                });
                left += width;
            });
            top += row.heightPt || 24;
        });
        return blocks;
    }

    previewSlide() {
        return {
            id: "preview-1",
            index: 0,
            title: "Preview slide",
            hidden: false,
            layout: null,
            background: "#fffcf6",
            notes: null,
            elements: [
                {
                    id: "preview-title",
                    kind: "text",
                    transform: { xPt: 72, yPt: 120, widthPt: 640, heightPt: 90, rotationDeg: null },
                    alt: null,
                    locked: false,
                    text: "OpenPPT editor",
                    style: { sizePt: 40, bold: true, color: "#1d1a16", align: "left" },
                },
                {
                    id: "preview-body",
                    kind: "text",
                    transform: { xPt: 72, yPt: 220, widthPt: 560, heightPt: 64, rotationDeg: null },
                    alt: null,
                    locked: false,
                    text: "Numeric editing needs the native window.",
                    style: { sizePt: 18, bold: false, color: "#6d6458", align: "left" },
                },
                {
                    id: "preview-shape",
                    kind: "shape",
                    transform: { xPt: 700, yPt: 110, widthPt: 180, heightPt: 180, rotationDeg: null },
                    alt: null,
                    locked: false,
                    content: { geometry: "ellipse", fill: "#f2ddd2", line: { color: "#a8451f", widthPt: 1 } },
                },
            ],
        };
    }

    measure() {
        const wrap = document.querySelector("[data-stage-wrap]");
        if (wrap) {
            const width = Math.max(wrap.clientWidth - 72, 120);
            const height = Math.max(wrap.clientHeight - 96, 120);
            this.scale = Math.max(0.08, Math.min(width / this.deckWidth(), height / this.deckHeight()));
        }
        if (this.presenting) {
            const width = Math.max(window.innerWidth - 96, 160);
            const height = Math.max(window.innerHeight - 150, 120);
            this.presentScale = Math.max(0.08, Math.min(width / this.deckWidth(), height / this.deckHeight()));
        }
    }

    async ready() {
        try {
            this.status = "Connected";
            await this.newDeck();
        } catch (error) {
            this.fail(error);
        }
    }

    rpc(type, payload) {
        const view = window;
        const webview = view.chrome && view.chrome.webview;
        if (!webview) {
            return Promise.reject(new Error("native window unavailable"));
        }
        const id = `q${++this.seq}`;
        return new Promise((resolve, reject) => {
            this.pending[id] = { resolve, reject };
            webview.postMessage(JSON.stringify(Object.assign({ type, id }, payload || {})));
        });
    }

    onHostMessage(event) {
        let data = event.data;
        if (typeof data === "string") {
            try {
                data = JSON.parse(data);
            } catch {
                return;
            }
        }
        if (!data || typeof data !== "object" || typeof data.id !== "string") {
            return;
        }
        const entry = this.pending[data.id];
        if (!entry) {
            return;
        }
        delete this.pending[data.id];
        if (typeof data.type === "string" && data.type.endsWith("Error")) {
            entry.reject(new Error(data.message || data.type));
        } else {
            entry.resolve(data);
        }
    }

    fail(error) {
        this.errorText = error instanceof Error ? error.message : String(error);
        this.status = "Failed";
    }

    async newDeck() {
        const response = await this.rpc("deck.create", { request: { title: "Untitled deck", size: "16:9" } });
        if (this.handle) {
            try {
                await this.rpc("deck.close", { handle: this.handle });
            } catch {
                // The previous deck is already gone.
            }
        }
        this.handle = response.handle;
        this.deck = response.deck;
        this.projectPath = "";
        this.savePath = "";
        this.imageCache = {};
        if (!this.deck.slides.length) {
            let report = await this.rpc("deck.edit", {
                handle: this.handle,
                request: { expectedRevision: this.deck.revision, operations: [{ op: "slide.add" }] },
            });
            this.deck = report.report.deck;
            const created = this.deck.slides[0];
            if (created) {
                report = await this.rpc("deck.edit", {
                    handle: this.handle,
                    request: {
                        expectedRevision: this.deck.revision,
                        operations: [{ op: "slide.setTitle", slideId: created.id, text: "Slide 1" }],
                    },
                });
                this.deck = report.report.deck;
            }
        }
        const first = this.deck.slides[0];
        this.selectedId = "";
        await this.selectSlide(first ? first.id : "");
        this.status = "New deck ready";
        this.errorText = "";
        this.measure();
    }

    async selectSlide(slideId) {
        this.currentSlideId = slideId;
        this.selectedId = "";
        if (!slideId) {
            this.slide = null;
            return;
        }
        const response = await this.rpc("deck.slide", { handle: this.handle, slideId });
        this.slide = response.slide;
        await this.loadAssets();
    }

    async loadAssets() {
        if (!this.slide) {
            return;
        }
        let changed = false;
        for (const element of this.slide.elements) {
            const assetId = element.content && element.content.assetId;
            if (!assetId || this.imageCache[assetId]) {
                continue;
            }
            try {
                const response = await this.rpc("deck.asset", { handle: this.handle, assetId });
                this.imageCache = Object.assign({}, this.imageCache, {
                    [assetId]: `data:${response.asset.mediaType};base64,${response.asset.base64}`,
                });
                changed = true;
            } catch {
                // Unreadable assets stay as placeholder boxes.
            }
        }
        if (changed) {
            this.imageCache = Object.assign({}, this.imageCache);
        }
    }

    async refresh() {
        const summary = await this.rpc("deck.summary", { handle: this.handle });
        this.deck = summary.deck;
        if (this.currentSlideId) {
            const response = await this.rpc("deck.slide", { handle: this.handle, slideId: this.currentSlideId });
            this.slide = response.slide;
            await this.loadAssets();
        }
    }

    async openPptx(path) {
        const response = await this.rpc("pptx.open", { path });
        await this.releasePlayer();
        this.playerHandle = response.handle;
        this.player = response.presentation;
        this.projectPath = path;
        this.savePath = path;
        this.selectedId = "";
        this.errorText = "";
        const first = this.player.slides[0];
        this.playerIndex = first ? first.index : 1;
        if (first) {
            await this.loadPlayerSlide(first.index);
        }
        this.status = `Playing ${this.player.slides.length} slides`;
        this.measure();
    }

    async releasePlayer() {
        const handle = this.playerHandle;
        this.playerHandle = 0;
        this.player = null;
        this.playerCache = {};
        this.playerIndex = 1;
        this.presenting = false;
        if (handle) {
            try {
                await this.rpc("pptx.close", { handle });
            } catch {
                // The playback handle is already gone.
            }
        }
    }

    async loadPlayerSlide(index) {
        if (!this.player) {
            return;
        }
        this.playerIndex = index;
        if (this.playerCache[index]) {
            return;
        }
        const response = await this.rpc("pptx.slide", { handle: this.playerHandle, index });
        this.playerCache = Object.assign({}, this.playerCache, { [index]: response.slide });
        this.status = `Slide ${index} of ${this.player.slides.length}`;
    }

    async stepPlayer(delta) {
        if (!this.player || !this.player.slides.length) {
            return;
        }
        const slides = this.player.slides;
        const index = Math.max(0, slides.findIndex((item) => item.index === this.playerIndex));
        const next = slides[Math.min(slides.length - 1, Math.max(0, index + delta))];
        if (next && next.index !== this.playerIndex) {
            await this.loadPlayerSlide(next.index);
        }
    }

    async closePlayer() {
        await this.releasePlayer();
        this.presenting = false;
        this.status = "Presentation closed";
        this.errorText = "";
        this.measure();
    }

    async applyEdit(operations) {
        const response = await this.rpc("deck.edit", {
            handle: this.handle,
            request: { expectedRevision: this.deck.revision, operations },
        });
        this.deck = response.report.deck;
        this.errorText = "";
        if (this.currentSlideId) {
            const detail = await this.rpc("deck.slide", { handle: this.handle, slideId: this.currentSlideId });
            this.slide = detail.slide;
            await this.loadAssets();
        }
        this.status = `Revision ${this.deck.revision}`;
    }

    async onClick(event) {
        const target = event.target;
        if (!target || !target.closest) {
            return;
        }
        const actionEl = target.closest("[data-action]");
        if (actionEl && actionEl.dataset.action) {
            await this.runAction(actionEl.dataset.action);
            return;
        }
        const playerThumb = target.closest("[data-player-slide]");
        if (playerThumb && playerThumb.dataset.playerSlide) {
            try {
                await this.loadPlayerSlide(Number(playerThumb.dataset.playerSlide));
            } catch (error) {
                this.fail(error);
            }
            return;
        }
        const thumb = target.closest("[data-slide-id]");
        if (thumb && thumb.dataset.slideId) {
            try {
                await this.selectSlide(thumb.dataset.slideId);
            } catch (error) {
                this.fail(error);
            }
        }
    }

    async runAction(action) {
        try {
            if (action === "new") {
                return await this.newDeck();
            }
            if (action === "open") {
                return await this.open();
            }
            if (action === "save") {
                return await this.save();
            }
            if (action === "undo") {
                return await this.history(false);
            }
            if (action === "redo") {
                return await this.history(true);
            }
            if (action === "present") {
                return this.enterPresent();
            }
            if (action === "player-prev") {
                return await this.stepPlayer(-1);
            }
            if (action === "player-next") {
                return await this.stepPlayer(1);
            }
            if (action === "player-present") {
                return this.enterPresent();
            }
            if (action === "player-exit") {
                return await this.closePlayer();
            }
            if (action === "present-prev") {
                return await this.presentStep(-1);
            }
            if (action === "present-next") {
                return await this.presentStep(1);
            }
            if (action === "present-exit") {
                return this.exitPresent();
            }
            if (action === "close-window") {
                return await this.rpc("close", {});
            }
            if (action === "add-slide") {
                return await this.addSlide();
            }
            if (action === "slide-up") {
                return await this.moveSlide(-1);
            }
            if (action === "slide-down") {
                return await this.moveSlide(1);
            }
            if (action === "slide-duplicate") {
                return await this.duplicateSlide();
            }
            if (action === "slide-delete") {
                return await this.deleteSlide();
            }
            if (action === "slide-hide") {
                return await this.toggleHidden();
            }
            if (action === "slide-notes") {
                return await this.saveNotes();
            }
            if (action === "add-text") {
                return await this.addText();
            }
            if (action === "add-shape") {
                return await this.addShape();
            }
            if (action === "add-image") {
                const input = document.querySelector('[data-file="image"]');
                if (input) {
                    input.click();
                }
                return;
            }
            if (action === "element-delete") {
                return await this.deleteElement();
            }
            if (action === "element-lock") {
                return await this.toggleLock();
            }
        } catch (error) {
            this.fail(error);
        }
    }

    async open() {
        const path = this.savePath.trim();
        if (!path) {
            this.errorText = "Type a project or presentation path before opening.";
            return;
        }
        if (this.isPresentationPath(path)) {
            return await this.openPptx(path);
        }
        if (this.playerMode()) {
            await this.releasePlayer();
        }
        const response = await this.rpc("deck.open", { path });
        if (this.handle) {
            try {
                await this.rpc("deck.close", { handle: this.handle });
            } catch {
                // The previous handle is already closed.
            }
        }
        this.handle = response.handle;
        this.deck = response.deck;
        this.projectPath = path;
        this.imageCache = {};
        const first = this.deck.slides[0];
        await this.selectSlide(first ? first.id : "");
        this.status = "Opened";
        this.errorText = "";
        this.measure();
    }

    async save() {
        const path = this.savePath.trim() || this.projectPath;
        if (!path) {
            this.errorText = "Type a project path before saving.";
            return;
        }
        const response = await this.rpc("deck.save", { handle: this.handle, path, overwrite: true });
        this.projectPath = path;
        this.status = `Saved ${response.report.bytes} bytes at revision ${response.report.revision}`;
        this.errorText = "";
    }

    async history(redo) {
        const response = await this.rpc(redo ? "deck.redo" : "deck.undo", { handle: this.handle });
        this.deck = response.report.deck;
        if (this.currentSlideId) {
            const detail = await this.rpc("deck.slide", { handle: this.handle, slideId: this.currentSlideId });
            this.slide = detail.slide;
            await this.loadAssets();
        }
        this.selectedId = "";
        this.status = redo ? "Redo" : "Undo";
        this.errorText = "";
    }

    async addSlide() {
        const current = this.currentSlide();
        const report = await this.rpc("deck.edit", {
            handle: this.handle,
            request: {
                expectedRevision: this.deck.revision,
                operations: [{ op: "slide.add", index: current ? current.index + 1 : undefined }],
            },
        });
        this.deck = report.report.deck;
        const created = report.report.results && report.report.results[0];
        const next = this.deck.slides.find((item) => item.id === created) || this.deck.slides[this.deck.slides.length - 1];
        await this.selectSlide(next ? next.id : "");
        this.status = "Slide added";
    }

    async moveSlide(delta) {
        const current = this.currentSlide();
        if (!current) {
            return;
        }
        const order = this.deck.slides.map((item) => item.id);
        const target = current.index + delta;
        if (target < 0 || target >= order.length) {
            return;
        }
        order.splice(current.index, 1);
        order.splice(target, 0, current.id);
        await this.applyEdit([{ op: "slide.reorder", slideIds: order }]);
    }

    async duplicateSlide() {
        const current = this.currentSlide();
        if (!current) {
            return;
        }
        const report = await this.rpc("deck.edit", {
            handle: this.handle,
            request: {
                expectedRevision: this.deck.revision,
                operations: [{ op: "slide.duplicate", slideId: current.id, index: current.index + 1 }],
            },
        });
        this.deck = report.report.deck;
        const created = report.report.results && report.report.results[0];
        await this.selectSlide(created || current.id);
        this.status = "Slide duplicated";
    }

    async deleteSlide() {
        const current = this.currentSlide();
        if (!current || this.deck.slides.length <= 1) {
            this.errorText = "A deck needs at least one slide.";
            return;
        }
        await this.applyEdit([{ op: "slide.remove", slideId: current.id }]);
        const next = this.deck.slides[Math.min(current.index, this.deck.slides.length - 1)];
        await this.selectSlide(next ? next.id : "");
    }

    async toggleHidden() {
        const current = this.currentSlide();
        if (!current) {
            return;
        }
        await this.applyEdit([{ op: "slide.setHidden", slideId: current.id, hidden: !current.hidden }]);
    }

    async saveNotes() {
        if (!this.slide) {
            return;
        }
        await this.applyEdit([{ op: "slide.setNotes", slideId: this.slide.id, text: this.slide.notes || "" }]);
        this.status = "Notes saved";
    }

    async addText() {
        if (!this.slide) {
            return;
        }
        const report = await this.rpc("deck.edit", {
            handle: this.handle,
            request: {
                expectedRevision: this.deck.revision,
                operations: [
                    {
                        op: "text.add",
                        slideId: this.slide.id,
                        text: "New text",
                        transform: { xPt: 96, yPt: 96, widthPt: 420, heightPt: 64 },
                    },
                ],
            },
        });
        this.deck = report.report.deck;
        const created = report.report.results && report.report.results[0];
        await this.refresh();
        this.selectedId = created || "";
        this.status = "Text added";
    }

    async addShape() {
        if (!this.slide) {
            return;
        }
        const report = await this.rpc("deck.edit", {
            handle: this.handle,
            request: {
                expectedRevision: this.deck.revision,
                operations: [
                    {
                        op: "shape.add",
                        slideId: this.slide.id,
                        geometry: "rect",
                        fill: "#f2ddd2",
                        line: { color: "#a8451f", widthPt: 1 },
                        transform: { xPt: 120, yPt: 120, widthPt: 260, heightPt: 160 },
                    },
                ],
            },
        });
        this.deck = report.report.deck;
        const created = report.report.results && report.report.results[0];
        await this.refresh();
        this.selectedId = created || "";
        this.status = "Shape added";
    }

    async addImage(file) {
        if (!this.slide) {
            return;
        }
        const base64 = await this.readBase64(file);
        const report = await this.rpc("deck.edit", {
            handle: this.handle,
            request: {
                expectedRevision: this.deck.revision,
                operations: [
                    {
                        op: "image.add",
                        slideId: this.slide.id,
                        alt: file.name,
                        transform: { xPt: 120, yPt: 120, widthPt: 360, heightPt: 240 },
                        asset: { name: file.name, mediaType: file.type || "image/png", base64 },
                    },
                ],
            },
        });
        this.deck = report.report.deck;
        const created = report.report.results && report.report.results[0];
        await this.refresh();
        this.selectedId = created || "";
        this.status = "Image added";
    }

    readBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => {
                const result = String(reader.result || "");
                resolve(result.slice(result.indexOf(",") + 1));
            };
            reader.onerror = () => reject(reader.error || new Error("unreadable file"));
            reader.readAsDataURL(file);
        });
    }

    async deleteElement() {
        const element = this.selectedElement();
        if (!element || !this.slide) {
            return;
        }
        await this.applyEdit([{ op: "element.remove", slideId: this.slide.id, elementId: element.id }]);
        this.selectedId = "";
        this.status = "Object removed";
    }

    async toggleLock() {
        const element = this.selectedElement();
        if (!element || !this.slide) {
            return;
        }
        const lock = !element.locked;
        await this.applyEdit([
            {
                op: "element.lock",
                slideId: this.slide.id,
                elementId: element.id,
                flags: { move: lock, resize: lock },
            },
        ]);
    }

    async commitTransform(patch) {
        const element = this.selectedElement();
        if (!element || !this.slide) {
            return;
        }
        const transform = Object.assign({}, element.transform, patch);
        await this.applyEdit([
            { op: "element.updateTransform", slideId: this.slide.id, elementId: element.id, transform },
        ]);
    }

    async onChange(event) {
        const target = event.target;
        if (!target) {
            return;
        }
        if (target.dataset && target.dataset.file === "image") {
            const file = target.files && target.files[0];
            target.value = "";
            if (file) {
                try {
                    await this.addImage(file);
                } catch (error) {
                    this.fail(error);
                }
            }
            return;
        }
        const field = target.dataset ? target.dataset.field : "";
        if (!field) {
            return;
        }
        const value = target.value;
        try {
            if (field === "savePath") {
                this.savePath = value;
                return;
            }
            if (field === "notes") {
                if (this.slide) {
                    this.slide = Object.assign({}, this.slide, { notes: value });
                }
                return;
            }
            if (field === "slide-title") {
                if (this.slide) {
                    await this.applyEdit([{ op: "slide.setTitle", slideId: this.slide.id, text: value }]);
                }
                return;
            }
            const element = this.selectedElement();
            if (!element || !this.slide) {
                return;
            }
            if (field === "text") {
                await this.applyEdit([
                    { op: "element.setText", slideId: this.slide.id, elementId: element.id, text: value },
                ]);
                return;
            }
            if (field === "alt") {
                await this.applyEdit([
                    { op: "element.updateAlt", slideId: this.slide.id, elementId: element.id, alt: value },
                ]);
                return;
            }
            const number = Number.parseFloat(value);
            if (!Number.isFinite(number)) {
                return;
            }
            const patch = {};
            if (field === "x") {
                patch.xPt = number;
            } else if (field === "y") {
                patch.yPt = number;
            } else if (field === "width") {
                patch.widthPt = Math.max(4, number);
            } else if (field === "height") {
                patch.heightPt = Math.max(4, number);
            } else if (field === "rotation") {
                patch.rotationDeg = number;
            } else {
                return;
            }
            await this.commitTransform(patch);
        } catch (error) {
            this.fail(error);
        }
    }

    onPointerDown(event) {
        if (this.presenting) {
            return;
        }
        const target = event.target;
        if (!target || !target.closest) {
            return;
        }
        const handle = target.closest("[data-handle]");
        if (handle && this.selectedElement()) {
            const element = this.selectedElement();
            const point = this.toPoints(event.clientX, event.clientY);
            this.drag = { mode: "resize", id: element.id, startX: point.x, startY: point.y, origin: Object.assign({}, element.transform) };
            event.preventDefault();
            return;
        }
        const holder = target.closest("[data-el-id]");
        if (!holder || !holder.dataset.elId) {
            return;
        }
        const element = this.slide ? this.slide.elements.find((item) => item.id === holder.dataset.elId) : null;
        if (!element) {
            return;
        }
        this.selectedId = element.id;
        if (element.locked) {
            return;
        }
        const point = this.toPoints(event.clientX, event.clientY);
        this.drag = { mode: "move", id: element.id, startX: point.x, startY: point.y, origin: Object.assign({}, element.transform) };
        event.preventDefault();
    }

    onPointerMove(event) {
        if (!this.drag) {
            return;
        }
        const point = this.toPoints(event.clientX, event.clientY);
        const dx = point.x - this.drag.startX;
        const dy = point.y - this.drag.startY;
        const origin = this.drag.origin;
        if (this.drag.mode === "move") {
            this.dragRect = Object.assign({}, origin, { xPt: origin.xPt + dx, yPt: origin.yPt + dy });
        } else {
            this.dragRect = Object.assign({}, origin, {
                widthPt: Math.max(8, origin.widthPt + dx),
                heightPt: Math.max(8, origin.heightPt + dy),
            });
        }
        this.dragTargetId = this.drag.id;
    }

    async onPointerUp() {
        if (!this.drag) {
            return;
        }
        const rect = this.dragRect;
        const id = this.drag.id;
        this.drag = null;
        this.dragRect = null;
        this.dragTargetId = "";
        if (!rect || !this.slide || !id) {
            return;
        }
        try {
            await this.applyEdit([
                { op: "element.updateTransform", slideId: this.slide.id, elementId: id, transform: rect },
            ]);
        } catch (error) {
            this.fail(error);
        }
    }

    toPoints(clientX, clientY) {
        const selector = this.presenting ? "[data-present-stage]" : "[data-stage]";
        const stage = document.querySelector(selector);
        if (!stage) {
            return { x: 0, y: 0 };
        }
        const rect = stage.getBoundingClientRect();
        const scale = rect.width / this.deckWidth();
        return { x: (clientX - rect.left) / scale, y: (clientY - rect.top) / scale };
    }

    onKeyDown(event) {
        const target = event.target;
        const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA");
        if (this.playerMode()) {
            if (typing) {
                return;
            }
            if (event.key === "ArrowRight" || event.key === " ") {
                event.preventDefault();
                void this.stepPlayer(1);
            } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                void this.stepPlayer(-1);
            } else if (event.key === "Escape") {
                if (this.presenting) {
                    this.exitPresent();
                } else {
                    void this.closePlayer();
                }
            }
            return;
        }
        if (this.presenting) {
            if (event.key === "ArrowRight" || event.key === " ") {
                event.preventDefault();
                void this.presentStep(1);
            } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                void this.presentStep(-1);
            } else if (event.key === "Escape") {
                this.exitPresent();
            }
            return;
        }
        if (typing) {
            return;
        }
        if (event.key === "Delete" || event.key === "Backspace") {
            if (this.selectedElement()) {
                event.preventDefault();
                void this.deleteElement().catch((error) => this.fail(error));
            }
        } else if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") {
            event.preventDefault();
            void this.save().catch((error) => this.fail(error));
        }
    }

    enterPresent() {
        if (this.playerMode()) {
            if (!this.player.slides.length) {
                return;
            }
        } else if (!this.deck.slides.length) {
            return;
        }
        this.presenting = true;
        this.selectedId = "";
        this.measure();
        setTimeout(() => this.measure(), 0);
    }

    exitPresent() {
        this.presenting = false;
        this.measure();
    }

    async presentStep(delta) {
        if (this.playerMode()) {
            return this.stepPlayer(delta);
        }
        const slides = this.deck.slides;
        const index = Math.max(0, slides.findIndex((item) => item.id === this.currentSlideId));
        const next = Math.min(slides.length - 1, Math.max(0, index + delta));
        if (slides[next] && slides[next].id !== this.currentSlideId) {
            try {
                await this.selectSlide(slides[next].id);
            } catch (error) {
                this.fail(error);
            }
        }
    }
}
</script>

}

.present-image {
    max-width: 92vw;
    max-height: 80vh;
    background: #fff;
    box-shadow: 0 20px 60px #0008;
}

.player {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    background: var(--op-bg);
}

.player-bar {
    display: flex;
    align-items: center;

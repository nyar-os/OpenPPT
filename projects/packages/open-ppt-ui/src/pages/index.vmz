<template>
    <div class="studio">
        <header class="bar">
            <div class="brand">
                <span class="mark">P</span>
                <div>
                    <h1>OpenPPT Studio</h1>
                    <p class="path" :title="projectPath">{{ projectPath || "unsaved native project" }}</p>
                </div>
            </div>
            <div class="bar-group grow">
                <input class="path-input" data-field="savePath" :value="savePath" placeholder="C:\decks\review.oppt" spellcheck="false" />
                <button class="btn" data-action="new">New</button>
                <button class="btn" data-action="open">Open</button>
                <button class="btn btn-primary" data-action="save">Save</button>
            </div>
            <div class="bar-group">
                <button class="btn" data-action="undo">Undo</button>
                <button class="btn" data-action="redo">Redo</button>
                <button class="btn" data-action="present">Present</button>
                <button class="btn btn-ghost" data-action="close-window">Close</button>
            </div>
        </header>

        <div class="main">
            <aside class="rail">
                <div class="rail-head">
                    <span>Slides</span>
                    <button class="icon-btn" data-action="add-slide" title="Add slide">+</button>
                </div>
                <div class="thumbs">
                    <div v-for="s in deck.slides" :key="s.id" class="thumb" :class="s.id === currentSlideId ? 'thumb active' : 'thumb'" :data-slide-id="s.id">
                        <span class="thumb-index">{{ s.index + 1 }}</span>
                        <div class="thumb-card">
                            <span class="thumb-title">{{ s.title }}</span>
                            <span class="thumb-meta">{{ s.elements }} objects</span>
                        </div>
                        <span class="thumb-hidden" v-if="s.hidden">hidden</span>
                    </div>
                </div>
                <div class="rail-actions">
                    <button class="btn btn-small" data-action="slide-up">Up</button>
                    <button class="btn btn-small" data-action="slide-down">Down</button>
                    <button class="btn btn-small" data-action="slide-duplicate">Duplicate</button>
                    <button class="btn btn-small" data-action="slide-delete">Delete</button>
                    <button class="btn btn-small" data-action="slide-hide">Hide</button>
                </div>
                <div class="rail-actions">
                    <button class="btn btn-small" data-action="add-text">+ Text</button>
                    <button class="btn btn-small" data-action="add-shape">+ Shape</button>
                    <button class="btn btn-small" data-action="add-image">+ Image</button>
                    <input class="file-input" type="file" accept="image/*" data-file="image" />
                </div>
            </aside>

            <main class="stage-wrap" data-stage-wrap>
                <div class="stage-frame" data-stage-frame :style="frameStyle()">
                    <div class="stage" data-stage :style="stageStyle()">
                        <div class="el" v-for="box in elementBoxes()" :key="box.id" :data-el-id="box.id" :style="box.style"></div>
                        <img class="el-image" v-for="image in imageBlocks()" :key="image.id" :data-el-id="image.id" :src="image.src" :style="image.style" alt="" />
                        <div class="text-block" v-for="block in textBlocks()" :key="block.key" :data-el-id="block.elId" :style="block.style">{{ block.text }}</div>
                        <div class="bar-block" v-for="bar in barBlocks()" :key="bar.key" :data-el-id="bar.elId" :style="bar.style"></div>
                        <div class="selection" v-if="hasSelection()" :style="selectionStyle()"></div>
                        <div class="handle" v-if="hasSelection()" data-handle="resize" :style="handleStyle()"></div>
                    </div>
                </div>
                <p class="hint">Drag to move · corner handle resizes · click a thumbnail to switch pages</p>
            </main>

            <aside class="inspector">
                <h2>Inspector</h2>
                <div v-if="hasSelection()">
                    <p class="badge">{{ selectedElement().kind }}</p>
                    <label class="field"><span>X</span><input type="number" step="1" data-field="x" :value="fieldValue('x')" /></label>
                    <label class="field"><span>Y</span><input type="number" step="1" data-field="y" :value="fieldValue('y')" /></label>
                    <label class="field"><span>W</span><input type="number" step="1" data-field="width" :value="fieldValue('width')" /></label>
                    <label class="field"><span>H</span><input type="number" step="1" data-field="height" :value="fieldValue('height')" /></label>
                    <label class="field"><span>Rotate</span><input type="number" step="1" data-field="rotation" :value="fieldValue('rotation')" /></label>
                    <label class="field"><span>Alt</span><input type="text" data-field="alt" :value="selectedElement().alt || ''" /></label>
                    <label class="field field-col" v-if="selectedElement().kind === 'text'"><span>Text</span><textarea rows="4" data-field="text">{{ selectedElement().text || "" }}</textarea></label>
                    <div class="field-row">
                        <button class="btn btn-small" data-action="element-lock">{{ selectedElement().locked ? "Unlock" : "Lock" }}</button>
                        <button class="btn btn-small btn-danger" data-action="element-delete">Delete</button>
                    </div>
                </div>
                <p v-else class="empty">Select an object on the canvas.</p>

                <h2>Slide</h2>
                <label class="field"><span>Title</span><input type="text" data-field="slide-title" :value="slide ? slide.title : ''" /></label>
                <label class="field field-col"><span>Notes</span><textarea rows="5" data-field="notes">{{ slide ? slide.notes || "" : "" }}</textarea></label>
                <div class="field-row">
                    <button class="btn btn-small" data-action="slide-notes">Save notes</button>
                </div>
            </aside>
        </div>

        <div class="player" v-if="playerMode()">
            <header class="player-bar">
                <div class="brand">
                    <span class="mark">P</span>
                    <div>
                        <h1>{{ playerTitle() }}</h1>
                        <p class="path" :title="projectPath">{{ projectPath }}</p>
                    </div>
                </div>
                <div class="bar-group grow">
                    <input class="path-input" data-field="savePath" :value="savePath" placeholder="C:\decks\slides.pptx" spellcheck="false" />
                    <button class="btn" data-action="open">Open</button>
                </div>
                <div class="bar-group">
                    <button class="btn" data-action="player-prev">Prev</button>
                    <span class="player-count">{{ playerIndex }} / {{ playerSlideCount() }}</span>
                    <button class="btn" data-action="player-next">Next</button>
                    <button class="btn btn-primary" data-action="player-present">Present</button>
                    <button class="btn btn-ghost" data-action="player-exit">Close</button>
                </div>
            </header>
            <div class="player-main">
                <aside class="player-rail">
                    <div class="rail-head"><span>Slides</span></div>
                    <div class="thumbs">
                        <div
                            v-for="s in playerSlides()"
                            :key="s.index"
                            class="thumb"
                            :class="s.index === playerIndex ? 'thumb active' : 'thumb'"
                            :data-player-slide="s.index"
                        >
                            <span class="thumb-index">{{ s.index }}</span>
                            <div class="thumb-card">
                                <span class="thumb-title">Slide {{ s.index }}</span>
                                <span class="thumb-meta">{{ round(s.widthPx) }}×{{ round(s.heightPx) }} px</span>
                            </div>
                        </div>
                    </div>
                </aside>
                <main class="player-stage-wrap" data-player-wrap>
                    <img class="player-image" v-if="playerImage()" :src="playerImage()" alt="" />
                    <p class="hint" v-else>Loading slide…</p>
                </main>
            </div>
            <footer class="statusbar">
                <span :class="errorText ? 'status error' : 'status'">{{ errorText || status }}</span>
                <span class="spacer"></span>
                <span>{{ playerIssueCount() }} issues · {{ playerCanvas() }}</span>
            </footer>
        </div>

        <footer class="statusbar">
            <span :class="errorText ? 'status error' : 'status'">{{ errorText || status }}</span>
            <span class="spacer"></span>
            <span v-if="deck">rev {{ deck.revision }} · {{ deck.slides.length }} slides · {{ round(deck.size.widthPt) }}×{{ round(deck.size.heightPt) }}pt</span>
        </footer>

        <div class="present" v-if="presenting">
            <div class="present-frame" data-present-frame :style="presentFrameStyle()">
                <img class="present-image" v-if="playerMode()" :src="playerImage()" alt="" />
                <div class="stage" v-else data-present-stage :style="presentStageStyle()">
                    <div class="el" v-for="box in elementBoxes()" :key="box.id" :style="box.style"></div>
                    <img class="el-image" v-for="image in imageBlocks()" :key="image.id" :src="image.src" :style="image.style" alt="" />
                    <div class="text-block" v-for="block in textBlocks()" :key="block.key" :style="block.style">{{ block.text }}</div>
                    <div class="bar-block" v-for="bar in barBlocks()" :key="bar.key" :style="bar.style"></div>
                </div>
            </div>
            <div class="present-bar">
                <button class="btn" data-action="present-prev">Prev</button>
                <span>{{ presentLabel() }}</span>
                <button class="btn" data-action="present-next">Next</button>
                <button class="btn btn-ghost" data-action="present-exit">Exit</button>
            </div>
        </div>
    </div>
</template>

<style>
.studio {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--op-bg);
}


{
    "name": "open-ppt-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "description": "OpenPPT workspace: .pptx authoring, template decks, editable presentations, and agent skills",
    "keywords": ["pptx", "powerpoint", "presentation", "slide", "template"],
    "license": "Apache-2.0",
    "repository": "https://github.com/nyar-os/OpenPPT",
    "scripts": {
        "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
        "build:napi": "wae native build",
        "build:ts": "pnpm --filter @wae/open-ppt run build",
        "build:ui": "pnpm --filter @wae/open-ppt-ui run build",
        "build": "wae build",
        "stage:native": "wae native stage",
        "typecheck": "pnpm -r --filter \"./projects/packages/*\" run typecheck",
        "test": "pnpm -r --filter \"./projects/packages/*\" run test",
        "gui": "pnpm run build && pnpm --filter @wae/open-ppt exec node ./dist/cli.js gui"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.17",
        "@types/node": "^22.20.4",
        "@wae/wae": "0.0.6",
        "typescript": "^5.9.2"
    }
}
